# Set ONE of these to enable the full agent (deck generation + free-form answers).
# Priority: ANTHROPIC_API_KEY first, then GEMINI_API_KEY, else offline matching.

# Anthropic Claude (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini (FREE tier, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server port (default 3001)
PORT=3001
